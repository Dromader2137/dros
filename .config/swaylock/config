# swaylock config — gruvbox
# Save as ~/.config/swaylock/config
# Colors are RRGGBB[AA], no leading # or 0x

# Background
color=282828

# Behaviour
ignore-empty-password
show-failed-attempts
indicator-caps-lock
indicator-idle-visible

# Indicator
indicator-radius=300
indicator-thickness=30
font=Mononoki Nerd Font

# Transparent separators/lines
separator-color=282828
line-uses-inside

# Idle (typing)
inside-color=282828
ring-color=a89984
text-color=ebdbb2
key-hl-color=98971a
bs-hl-color=cc241d

# Cleared (backspaced to empty)
inside-clear-color=282828
ring-clear-color=d79921
text-clear-color=d79921

# Verifying
inside-ver-color=282828
ring-ver-color=458588
text-ver-color=458588

# Wrong password
inside-wrong-color=282828
ring-wrong-color=cc241d
text-wrong-color=cc241d

# Caps lock
inside-caps-lock-color=282828
ring-caps-lock-color=b16286
text-caps-lock-color=b16286
caps-lock-key-hl-color=98971a
caps-lock-bs-hl-color=cc241d

# Keyboard layout indicator
layout-bg-color=282828
layout-border-color=a89984
layout-text-color=ebdbb2
